# RetailHOT 的 nginx 配置（由 deploy/install.sh 生成，占位符 __XXX__ 会被替换）。
#   __SITE_DOMAIN__  站点域名，例如 retailhot.butik.com.cn
#   __CERT_DIR__     证书目录（里面有 fullchain.pem 和 privkey.pem，泛域名证书）
#
# 443 不开 http2：nginx 1.25 以前 http2 按"IP + 端口"生效，这里一开，同一台服务器上所有 443 站点都会变成 HTTP/2。
# ai_demo 是共享服务器，不能影响其他站点。

server {
    listen 80;
    listen [::]:80;
    server_name __SITE_DOMAIN__;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __SITE_DOMAIN__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:retailhot:10m;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        # 网站的 TRUST_PROXY=true：访客地址从这里读，所以必须覆盖成 nginx 看到的真实地址，不能透传客户端自带的值。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
