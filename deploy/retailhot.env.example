# RetailHOT 在服务器上的配置。复制到 /etc/retailhot/.env（root 所有，权限 600），按注释填写。
# 不要提交到 Git，也不要发给任何人。install.sh 会检查标了“必填”的项。
# 完整的可选项见仓库根目录的 .env.example。

# ===== 必填 =====
SITE_URL=https://retailhot.butik.com.cn
# 站点域名：nginx 配置用，要和 SITE_URL 的域名一致
SITE_DOMAIN=retailhot.butik.com.cn
# 网页只给本机的 nginx 用；前面有 nginx 时访客地址从请求头读
PORT=127.0.0.1:3000
TRUST_PROXY=true

# 至少 12 位，登录 /admin 用
ADMIN_PASSWORD=
# 各用 openssl rand -hex 32 生成
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 数据库用宿主机的 PostgreSQL 16（不用 compose 自带的 db 容器）。
# 先在宿主机建角色和库：CREATE ROLE retailhot LOGIN PASSWORD '…' CONNECTION LIMIT 30; CREATE DATABASE retailhot OWNER retailhot;
# 再在 pg_hba.conf 里加一行，只放行 Docker 私有网段：host retailhot retailhot 172.16.0.0/12 scram-sha-256
# 密码用十六进制字符（openssl rand -hex 32），免得连接串里要转义。
RETAILHOT_DATABASE_URL=postgres://retailhot:密码@host.docker.internal:5432/retailhot
# 让 docker compose 自动合并这个覆盖文件（去掉 db 容器，连宿主机的库）
COMPOSE_FILE=docker-compose.yml:deploy/compose.host-db.yml
# 每个进程的数据库连接池上限（默认 10）：宿主机的库还有别的项目在用，这里收小一点
DATABASE_POOL_MAX=6

# 模型：千问（阿里云百炼 DashScope）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
LLM_EXTRA_JSON={"enable_thinking":false}

# ===== 选填 =====
# 向量召回让事件归组更准：填同一个百炼 key
DASHSCOPE_API_KEY=

# 关掉就不抓信源、不调模型
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# 其他推送和外部服务默认都关着
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
